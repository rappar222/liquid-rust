#version 310 es
precision highp float;
precision highp int;

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std140, binding = 0) uniform SimUniforms {
    vec4 u_bounds_min;
    vec4 u_bounds_max;
    vec4 u_gravity_dt;
    ivec4 u_grid_dim;
    vec4 u_touch_orig;
    vec4 u_touch_dir;
    vec4 u_obstacle;
    vec4 u_kernel;
    vec4 u_factors;
    vec4 u_solver;
    vec4 u_fluid;
    ivec4 u_counts;
    vec4 u_extra;
};

layout(std430, binding = 0) writeonly buffer GridBuf {
    uint grid_data[];
};

void main() {
    uint cell_idx = gl_GlobalInvocationID.x;
    if (cell_idx < uint(u_grid_dim.w)) {
        grid_data[cell_idx] = 0u;
    }
}
