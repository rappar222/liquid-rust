#version 310 es
precision highp float;
precision highp int;

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std140, binding = 0) uniform SimUniforms {
    vec4 u_bounds_min;
    vec4 u_bounds_max;
    vec4 u_gravity_dt;
    ivec4 u_grid_dim;
    vec4 u_touch_orig;
    vec4 u_touch_dir;
    vec4 u_obstacle;
    vec4 u_kernel;       // x: h, y: h2, z: inv_rho0
    vec4 u_factors;      // x: poly6, y: spiky
    vec4 u_solver;
    vec4 u_fluid;
    ivec4 u_counts;
    vec4 u_extra;
};

layout(std430, binding = 0) readonly buffer PosBuf {
    vec4 pos_buf[];
};

layout(std430, binding = 1) readonly buffer VelBuf {
    vec4 vel_buf[];
};

layout(std430, binding = 2) readonly buffer GridBuf {
    uint grid_data[];
};

layout(std430, binding = 3) writeonly buffer CurlOutBuf {
    vec4 curl_out[];
};

vec3 spiky_grad(vec3 r_vec, float r, float h, float spiky_factor) {
    if (r < h && r > 1e-6) {
        float diff = h - r;
        return r_vec * (-spiky_factor * diff * diff / r);
    }
    return vec3(0.0);
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(u_counts.x)) {
        return;
    }

    vec3 pos_i = pos_buf[i].xyz;
    vec3 vel_i = vel_buf[i].xyz;
    float h = u_kernel.x;
    float h2 = u_kernel.y;
    float inv_rho0 = u_kernel.z;
    float spiky_factor = u_factors.y;
    float cell_size = u_bounds_min.w;
    ivec3 dim = u_grid_dim.xyz;
    uint total_cells = uint(u_grid_dim.w);
    bool is_2d = (u_counts.y != 0);

    ivec3 cell = clamp(
        ivec3(floor((pos_i - u_bounds_min.xyz) / cell_size)),
        ivec3(0),
        dim - ivec3(1)
    );

    vec3 curl = vec3(0.0);
    int z_min = is_2d ? 0 : -1;
    int z_max = is_2d ? 0 : 1;

    for (int dz = z_min; dz <= z_max; dz++) {
        int cz = cell.z + dz;
        if (cz < 0 || cz >= dim.z) continue;
        for (int dy = -1; dy <= 1; dy++) {
            int cy = cell.y + dy;
            if (cy < 0 || cy >= dim.y) continue;
            for (int dx = -1; dx <= 1; dx++) {
                int cx = cell.x + dx;
                if (cx < 0 || cx >= dim.x) continue;

                uint c_idx = uint(cx + cy * dim.x + cz * (dim.x * dim.y));
                uint curr = grid_data[c_idx];
                int guard = 0;
                while (curr != 0u && guard < 128) {
                    uint j = curr - 1u;
                    curr = grid_data[total_cells + j];
                    guard++;

                    if (i != j) {
                        vec3 r_vec = pos_i - pos_buf[j].xyz;
                        float r2 = dot(r_vec, r_vec);
                        if (r2 < h2 && r2 > 1e-12) {
                            float r = sqrt(r2);
                            vec3 v_diff = vel_buf[j].xyz - vel_i;
                            curl += cross(v_diff, spiky_grad(r_vec, r, h, spiky_factor)) * inv_rho0;
                        }
                    }
                }
            }
        }
    }

    curl_out[i] = vec4(curl, length(curl));
}
