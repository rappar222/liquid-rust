#version 310 es
precision highp float;
precision highp int;

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std140, binding = 0) uniform SimUniforms {
    vec4 u_bounds_min;
    vec4 u_bounds_max;
    vec4 u_gravity_dt;
    ivec4 u_grid_dim;
    vec4 u_touch_orig;
    vec4 u_touch_dir;
    vec4 u_obstacle;
    vec4 u_kernel;
    vec4 u_factors;
    vec4 u_solver;
    vec4 u_fluid;
    ivec4 u_counts;
    vec4 u_extra;
};

layout(std430, binding = 0) readonly buffer PredBuf {
    vec4 pred_buf[];
};

layout(std430, binding = 1) coherent buffer GridBuf {
    uint grid_data[];
};

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(u_counts.x)) {
        return;
    }

    vec3 pos = pred_buf[i].xyz;
    float cell_size = u_bounds_min.w;
    ivec3 dim = u_grid_dim.xyz;

    ivec3 cell = clamp(
        ivec3(floor((pos - u_bounds_min.xyz) / cell_size)),
        ivec3(0),
        dim - ivec3(1)
    );
    uint cell_idx = uint(cell.x + cell.y * dim.x + cell.z * (dim.x * dim.y));
    uint total_cells = uint(u_grid_dim.w);

    uint prev = atomicExchange(grid_data[cell_idx], i + 1u);
    grid_data[total_cells + i] = prev;
}
