#version 310 es
precision highp float;
precision highp int;

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std140, binding = 0) uniform SimUniforms {
    vec4 u_bounds_min;   // xyz: bounds min, w: cell_size
    vec4 u_bounds_max;   // xyz: bounds max, w: particle_radius
    vec4 u_gravity_dt;   // xyz: gravity, w: dt
    ivec4 u_grid_dim;    // xyz: dim, w: total_cells
    vec4 u_touch_orig;   // xyz: ray origin, w: strength
    vec4 u_touch_dir;    // xyz: ray dir, w: mode (-1 repel, 0 off, +1 attract)
    vec4 u_obstacle;     // xyz: sphere pos, w: sphere radius
    vec4 u_kernel;       // x: h, y: h2, z: inv_rho0, w: rho0
    vec4 u_factors;      // x: poly6, y: spiky, z: w_q, w: tensile_k
    vec4 u_solver;       // x: eps, y: max_disp, z: restitution, w: friction
    vec4 u_fluid;        // x: viscosity, y: st_coeff, z: max_vel, w: obs_enabled
    ivec4 u_counts;      // x: particle_count, y: is_2d, z: pad, w: pad
    vec4 u_extra;        // x: vorticity, y: spacing, z: cfm_scale, w: self_density
};

layout(std430, binding = 0) readonly buffer PosBuf {
    vec4 pos_buf[];
};

layout(std430, binding = 1) readonly buffer VelBuf {
    vec4 vel_buf[];
};

layout(std430, binding = 2) writeonly buffer PredBuf {
    vec4 pred_buf[];
};

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(u_counts.x)) {
        return;
    }

    vec4 pos_rho = pos_buf[i];
    vec3 p_pos = pos_rho.xyz;
    vec3 vel = vel_buf[i].xyz;
    float dt = u_gravity_dt.w;
    bool is_2d = (u_counts.y != 0);

    vec3 f_user = vec3(0.0);
    int touch_mode = int(round(u_touch_dir.w));
    if (touch_mode != 0) {
        vec3 orig = u_touch_orig.xyz;
        vec3 dir = u_touch_dir.xyz;
        vec3 to_p = p_pos - orig;
        float proj = dot(to_p, dir);
        if (proj > 0.0) {
            vec3 closest = orig + dir * proj;
            vec3 diff = closest - p_pos;
            if (is_2d) {
                diff.z = 0.0;
            }
            float dist = length(diff);
            const float interact_radius = 0.52;
            if (dist < interact_radius && dist > 1e-4) {
                vec3 n_dir = diff / dist;
                float falloff = 1.0 - (dist / interact_radius);
                float strength = u_touch_orig.w * falloff;
                if (touch_mode > 0) {
                    // Smooth spring-damped attraction so particles swirl around finger without exploding
                    f_user = n_dir * strength - vel * 2.2 * falloff;
                } else {
                    f_user = -n_dir * (strength * 1.25);
                }
            }
        }
    }

    vel += (u_gravity_dt.xyz + f_user) * dt;
    vec3 pred = p_pos + vel * dt;

    float radius = u_bounds_max.w;
    vec3 b_min_eff = u_bounds_min.xyz + vec3(radius, radius, is_2d ? 0.0 : radius);
    vec3 b_max_eff = u_bounds_max.xyz - vec3(radius, radius, is_2d ? 0.0 : radius);
    pred = clamp(pred, b_min_eff, b_max_eff);
    if (is_2d) {
        pred.z = 0.0;
    }

    pred_buf[i] = vec4(pred, pos_rho.w);
}
