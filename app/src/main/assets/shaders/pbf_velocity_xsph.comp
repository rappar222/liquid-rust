#version 310 es
precision highp float;
precision highp int;

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std140, binding = 0) uniform SimUniforms {
    vec4 u_bounds_min;
    vec4 u_bounds_max;
    vec4 u_gravity_dt;
    ivec4 u_grid_dim;
    vec4 u_touch_orig;
    vec4 u_touch_dir;
    vec4 u_obstacle;
    vec4 u_kernel;       // x: h, y: h2, z: inv_rho0, w: rho0
    vec4 u_factors;      // x: poly6, y: spiky
    vec4 u_solver;       // x: eps, y: max_disp, z: restitution, w: friction
    vec4 u_fluid;        // x: viscosity, y: st_coeff, z: max_vel, w: obs_enabled
    ivec4 u_counts;      // x: particle_count, y: is_2d
    vec4 u_extra;
};

layout(std430, binding = 0) readonly buffer NewPosBuf {
    vec4 new_pos_buf[];  // xyz: final predicted pos, w: density
};

layout(std430, binding = 1) readonly buffer OldPosBuf {
    vec4 old_pos_buf[];  // xyz: start-of-substep pos, w: density
};

layout(std430, binding = 2) readonly buffer GridBuf {
    uint grid_data[];
};

layout(std430, binding = 3) writeonly buffer VelOutBuf {
    vec4 vel_out[];      // xyz: velocity, w: normalized pressure
};

float poly6(float r2, float h2, float poly6_factor) {
    if (r2 < h2 && r2 >= 0.0) {
        float diff = h2 - r2;
        return poly6_factor * diff * diff * diff;
    }
    return 0.0;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(u_counts.x)) {
        return;
    }

    vec4 np = new_pos_buf[i];
    vec3 new_pos = np.xyz;
    float rho_i = np.w;
    vec3 old_pos = old_pos_buf[i].xyz;

    float dt = u_gravity_dt.w;
    float inv_dt = 1.0 / max(dt, 1e-6);
    vec3 vel = (new_pos - old_pos) * inv_dt;

    float radius = u_bounds_max.w;
    float restitution = u_solver.z;
    float friction = u_solver.w;
    float margin = max(radius * 0.20, 0.002);
    vec3 b_min = u_bounds_min.xyz;
    vec3 b_max = u_bounds_max.xyz;
    bool is_2d = (u_counts.y != 0);

    float slip_floor = clamp(1.0 - max(1.0 - friction, 0.0) * dt * 1.5, 0.985, 1.0);
    const float slip_wall = 0.999;
    const float rest_threshold = 0.12;

    if (new_pos.y <= b_min.y + radius + margin) {
        if (vel.y < 0.0) {
            vel.y = (vel.y < -rest_threshold) ? (-vel.y * restitution) : 0.0;
        }
        vel.x *= slip_floor;
        vel.z *= slip_floor;
    }
    if (new_pos.y >= b_max.y - radius - margin && vel.y > 0.0) {
        vel.y = (vel.y > rest_threshold) ? (-vel.y * restitution) : 0.0;
        vel.x *= slip_wall;
        vel.z *= slip_wall;
    }
    if (new_pos.x <= b_min.x + radius + margin && vel.x < 0.0) {
        vel.x = (vel.x < -rest_threshold) ? (-vel.x * restitution) : 0.0;
        vel.y *= slip_wall;
        vel.z *= slip_wall;
    }
    if (new_pos.x >= b_max.x - radius - margin && vel.x > 0.0) {
        vel.x = (vel.x > rest_threshold) ? (-vel.x * restitution) : 0.0;
        vel.y *= slip_wall;
        vel.z *= slip_wall;
    }
    if (!is_2d) {
        if (new_pos.z <= b_min.z + radius + margin && vel.z < 0.0) {
            vel.z = (vel.z < -rest_threshold) ? (-vel.z * restitution) : 0.0;
            vel.x *= slip_wall;
            vel.y *= slip_wall;
        }
        if (new_pos.z >= b_max.z - radius - margin && vel.z > 0.0) {
            vel.z = (vel.z > rest_threshold) ? (-vel.z * restitution) : 0.0;
            vel.x *= slip_wall;
            vel.y *= slip_wall;
        }
    }

    // XSPH artificial viscosity
    float viscosity = u_fluid.x;
    if (viscosity > 0.0001) {
        float h2 = u_kernel.y;
        float poly6_factor = u_factors.x;
        float cell_size = u_bounds_min.w;
        ivec3 dim = u_grid_dim.xyz;
        uint total_cells = uint(u_grid_dim.w);

        ivec3 cell = clamp(
            ivec3(floor((new_pos - b_min) / cell_size)),
            ivec3(0),
            dim - ivec3(1)
        );

        vec3 sum_v_diff = vec3(0.0);
        float sum_weights = 0.0;
        int z_min = is_2d ? 0 : -1;
        int z_max = is_2d ? 0 : 1;

        for (int dz = z_min; dz <= z_max; dz++) {
            int cz = cell.z + dz;
            if (cz < 0 || cz >= dim.z) continue;
            for (int dy = -1; dy <= 1; dy++) {
                int cy = cell.y + dy;
                if (cy < 0 || cy >= dim.y) continue;
                for (int dx = -1; dx <= 1; dx++) {
                    int cx = cell.x + dx;
                    if (cx < 0 || cx >= dim.x) continue;

                    uint c_idx = uint(cx + cy * dim.x + cz * (dim.x * dim.y));
                    uint curr = grid_data[c_idx];
                    int guard = 0;
                    while (curr != 0u && guard < 128) {
                        uint j = curr - 1u;
                        curr = grid_data[total_cells + j];
                        guard++;

                        if (i != j) {
                            vec3 pj = new_pos_buf[j].xyz;
                            vec3 r_vec = new_pos - pj;
                            float r2 = dot(r_vec, r_vec);
                            if (r2 < h2 && r2 > 1e-12) {
                                vec3 vj = (pj - old_pos_buf[j].xyz) * inv_dt;
                                float w_ij = poly6(r2, h2, poly6_factor);
                                sum_v_diff += (vj - vel) * w_ij;
                                sum_weights += w_ij;
                            }
                        }
                    }
                }
            }
        }

        if (sum_weights > 1e-6) {
            vel += (sum_v_diff / sum_weights) * viscosity;
        }
    }

    float max_v = u_fluid.z;
    float speed = length(vel);
    if (speed > max_v && speed > 1e-6) {
        vel *= (max_v / speed);
    }
    if (is_2d) {
        vel.z = 0.0;
    }

    float pres_norm = clamp((rho_i * u_kernel.z - 1.0) / 0.45, 0.0, 1.0);
    vel_out[i] = vec4(vel, pres_norm);
}
