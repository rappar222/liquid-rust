# Maintainer: Radu <rappar2018@gmail.com>
pkgname=liquid-rust-bin
pkgver=0.3.3
pkgrel=1
pkgdesc="High-performance 2D/3D SPH fluid simulator in Rust with GPU acceleration (Vulkan) and real-time visualization"
arch=('x86_64')
url="https://github.com/rappar222/liquid-rust"
license=('MIT')
depends=('vulkan-icd-loader' 'libx11' 'libxcursor' 'libxi' 'libxrandr' 'libxkbcommon' 'wayland')
provides=('liquid-rust')
conflicts=('liquid-rust')

source=(
    "${pkgname}-${pkgver}::https://github.com/rappar222/liquid-rust/releases/download/v${pkgver}/liquid-rust"
    "LICENSE-${pkgver}::https://raw.githubusercontent.com/rappar222/liquid-rust/v${pkgver}/LICENSE"
    "liquid-rust.desktop-${pkgver}::https://raw.githubusercontent.com/rappar222/liquid-rust/v${pkgver}/assets/desktop/liquid-rust.desktop"
    "liquid-rust-2d.desktop-${pkgver}::https://raw.githubusercontent.com/rappar222/liquid-rust/v${pkgver}/assets/desktop/liquid-rust-2d.desktop"
    "liquid-rust.svg-${pkgver}::https://raw.githubusercontent.com/rappar222/liquid-rust/v${pkgver}/assets/icons/liquid-rust.svg"
    "liquid-rust-2d.svg-${pkgver}::https://raw.githubusercontent.com/rappar222/liquid-rust/v${pkgver}/assets/icons/liquid-rust-2d.svg"
)

sha256sums=(
    '72b2ede8b981f1d44981023db22156a39a00ddc4dfe8219a7346a97ab03cef02'
    '9816d5fed7378931000aa9cd4d062c89bc4773f66f87a60c5604a9d7e796c380'
    '18c3ecc29ee7bad5096fc6a06cb4760ddbbc5810ca85178d25d870fe0a4a5f33'
    'ddad1e02aba607db00a36fe4cdcc81e715d0352a2a9e4e76ca03413d304c8fa9'
    'fd22a86a2a59ddd5d84cc53311df3457810cadcdaef5ea1e14cb02c914f11a2c'
    '33f2517a2cac68ad8345de5640dd3db24aabded01bce13a105d6e79e3eea0c98'
)

package() {
    install -Dm755 "${srcdir}/${pkgname}-${pkgver}" "${pkgdir}/usr/bin/liquid-rust"
    install -Dm644 "${srcdir}/LICENSE-${pkgver}" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    install -Dm644 "${srcdir}/liquid-rust.desktop-${pkgver}" "${pkgdir}/usr/share/applications/liquid-rust.desktop"
    install -Dm644 "${srcdir}/liquid-rust-2d.desktop-${pkgver}" "${pkgdir}/usr/share/applications/liquid-rust-2d.desktop"
    install -Dm644 "${srcdir}/liquid-rust.svg-${pkgver}" "${pkgdir}/usr/share/icons/hicolor/scalable/apps/liquid-rust.svg"
    install -Dm644 "${srcdir}/liquid-rust-2d.svg-${pkgver}" "${pkgdir}/usr/share/icons/hicolor/scalable/apps/liquid-rust-2d.svg"
}
