# Maintainer: Radu <rappar2018@gmail.com>
pkgname=liquid-rust
pkgver=0.3.2
pkgrel=1
pkgdesc="High-performance 2D/3D SPH fluid simulator in Rust with GPU acceleration (Vulkan) and real-time visualization"
arch=('x86_64')
url="https://github.com/rappar222/liquid-rust"
license=('MIT')
depends=('vulkan-icd-loader' 'libx11' 'libxcursor' 'libxi' 'libxrandr' 'libxkbcommon' 'wayland')
makedepends=('cargo')
provides=('liquid-rust')
conflicts=('liquid-rust-bin')

source=(
    "${pkgname}-${pkgver}.tar.gz::https://github.com/rappar222/liquid-rust/archive/refs/tags/v${pkgver}.tar.gz"
)
sha256sums=(
    '48ea6d374a0bc9c8f851b41552f1fb36e746ac01a29954597bce2deab4d9895c'
)

prepare() {
    cd "${srcdir}/${pkgname}-${pkgver}"
    cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
    cd "${srcdir}/${pkgname}-${pkgver}"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release --all-targets
}

package() {
    cd "${srcdir}/${pkgname}-${pkgver}"
    install -Dm755 target/release/liquid-rust "${pkgdir}/usr/bin/liquid-rust"
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    install -Dm644 assets/desktop/liquid-rust.desktop "${pkgdir}/usr/share/applications/liquid-rust.desktop"
    install -Dm644 assets/desktop/liquid-rust-2d.desktop "${pkgdir}/usr/share/applications/liquid-rust-2d.desktop"
    install -Dm644 assets/icons/liquid-rust.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/liquid-rust.svg"
    install -Dm644 assets/icons/liquid-rust-2d.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/liquid-rust-2d.svg"
}
